# TomatoTogether 环境配置示例
# 复制此文件为 .env 并修改对应值

# 服务器配置
PORT=8080
DB_PATH=./data/tomatogether.db

# 房间配置
SINGLE_ROOM_MODE=false

# CORS 配置（逗号分隔，* 表示允许所有）
CORS_ORIGINS=*

# JWT 配置
JWT_SECRET=your-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRY=3600
JWT_REFRESH_TOKEN_EXPIRY=2592000

# RoomToken 配置
ROOM_TOKEN_EXPIRY=86400

# SSE 配置
SSE_TICK_INTERVAL=5
SSE_PING_INTERVAL=30
SSE_OFFLINE_TIMEOUT=120