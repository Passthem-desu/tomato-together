# TomatoTogether 环境配置示例
# 复制此文件为 .env 并修改对应值

# 服务器配置
PORT=8080
DB_PATH=./data/tomatogether.db
STATIC_DIR=./static

# CORS 配置
# 开发环境使用 * 允许所有来源
# 生产环境改为实际域名，如: https://yourdomain.com
CORS_ORIGIN=*

# JWT 认证配置
# JWT_SECRET: JWT 签名密钥，生产环境务必修改为随机字符串
JWT_SECRET=change-me-to-a-random-string-in-production

# JWT_ACCESS_TOKEN_EXPIRY: Access Token 有效期（秒），默认 3600（1小时）
# JWT_ACCESS_TOKEN_EXPIRY=3600

# JWT_REFRESH_TOKEN_EXPIRY: Refresh Token 有效期（秒），默认 2592000（30天）
# JWT_REFRESH_TOKEN_EXPIRY=2592000

# ROOM_TOKEN_EXPIRY: 匿名用户 RoomToken 有效期（秒），默认 86400（24小时）
# ROOM_TOKEN_EXPIRY=86400
